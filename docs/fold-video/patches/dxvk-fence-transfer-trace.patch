+  void D3D11Fence::TraceTransfer(const char* operation, const void* context, UINT64 value) const {
+#ifdef __ANDROID__
+    static const bool enabled = env::getEnvVar("NPT_D3D11_FENCE_TRANSFER_TRACE") == "1";
+    if (!enabled)
+      return;
+
+    // Bound per-process output. Object addresses are local to the renderer.
+    static std::atomic<uint32_t> records { 0 };
+    if (records.fetch_add(1, std::memory_order_relaxed) >= 256)
+      return;
+
+    Logger::warn(str::format("NPT-D3D11-FENCE-TRANSFER pid=", getpid(),
+      " op=", operation, " context=", context, " fence=", static_cast<const void*>(this),
+      " flags=", uint32_t(m_flags), " value=", value));
+#endif
   }
 
 
