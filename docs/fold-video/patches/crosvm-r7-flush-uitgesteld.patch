+    /// r7: wait for deferred scanout source reads; timing goes into the lease log line.
+    fn drain_deferred_reads(&mut self) -> std::result::Result<bool, String> {
+        if self.deferred_reads.is_empty() { return Ok(true); }
+        let t0 = std::time::Instant::now();
+        let fences = std::mem::take(&mut self.deferred_reads);
+        let r = wait_display_reads(&fences, self.display_read_kill);
+        let us = t0.elapsed().as_micros() as u64;
+        self.read_wait_us_sum = self.read_wait_us_sum.saturating_add(us);
+        self.read_wait_us_max = self.read_wait_us_max.max(us);
+        self.read_waits = self.read_waits.saturating_add(1);
+        r
+    }
