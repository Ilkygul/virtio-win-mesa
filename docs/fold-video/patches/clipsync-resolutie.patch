+        gip=$(guest_ip)
+        [ -n "$wh" ] && [ -n "$gip" ] && ( for i in $(seq 1 30); do echo "R $wh" | toybox nc -w 2 "$gip" 6202 >/dev/null 2>&1 && break; sleep 10; done ) </dev/null >/dev/null 2>&1 &
         echo "Windows-scherm geopend op scherm ${disp:-0}" ;;
     pauze)
         # Sleep mode: stop the VM's processors (memory stays), or let them run again. Saves battery while
