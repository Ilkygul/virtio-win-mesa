@@ -177,6 +177,11 @@ case "${1:-status}" in
         am start --display "${disp:-0}" -n cn.classfun.droidvm/.ui.vm.display.nativedisplay.display.VMNativeDisplayActivity \
             --es vm_id "$id" --es vm_name "$VM_NAME_FULL" --es screen gpu-0 --ez input_enabled true \
