         FormClosed += (s, e) => tray.Visible = false;
         var t = new Thread(Serve) { IsBackground = true };
         t.Start();
+        new Thread(ServeControl) { IsBackground = true }.Start();
+        // Re-apply the remembered choice once viogpuap has settled after logon.
+        var startTimer = new System.Windows.Forms.Timer { Interval = 6000 };
+        startTimer.Tick += (s, e) => { startTimer.Stop(); ApplyResolution(resChoice, hzChoice, false); };
