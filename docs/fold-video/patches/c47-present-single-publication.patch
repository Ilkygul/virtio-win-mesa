+/* Only the generated, no-reply Signal40 + Flush24 internal Present tail.
+ * Pending batchable methods are already globally ordered on this ring; keep
+ * them in the same publication instead of minting an extra prefix credit.
+ * wait_space still publishes that prefix when required for forward progress.
+ * All ordinary raw/control/reply callers retain their existing frontiers. */
+bool
+npt_ring_submit_present_pair(struct npt_ring *ring, const void *pair)
+{
+   if (!ring || !pair || !ring->publisher_job_v1 ||
+       ring->direct_size < 64 || ring->buffer_size < 64)
+      return false;
+
+   npt_ring_stage_flush_self(ring);
+   npt_runtime_ring_lock(ring);
+   const bool ok = npt_ring_submit_locked(ring, pair, 64);
+   npt_ring_unlock_and_notify(ring);
+   return ok;
+}
+
