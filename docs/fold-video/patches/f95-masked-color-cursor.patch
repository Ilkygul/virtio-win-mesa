+        for (UINT y = 0; y < h; y++)
+        {
+            const ULONG *p = (const ULONG *)((const BYTE *)s->pPixels + (SIZE_T)y * s->Pitch);
+            for (UINT x = 0; x < s->Width; x++)
+            {
+                if ((p[x] >> 24) && (p[x] & 0x00FFFFFFu))
+                    return STATUS_UNSUCCESSFUL;
+            }
+        }
+    }
     if (!CursorEnsure())
         return STATUS_UNSUCCESSFUL;
 
