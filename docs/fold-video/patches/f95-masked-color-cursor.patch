+++ b/viogpu/viogpu3d/viogpu3d.inx
@@ -96,7 +96,7 @@ HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
 HKR,,TypesSupported,%REG_DWORD%,7
 
