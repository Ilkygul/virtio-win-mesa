+old=
+if [ "${FOLD_DEX_BEWAAR_APPS:-0}" != 1 ]; then
+    old=$(cat /proc/sys/vm/compaction_proactiveness 2>/dev/null)
+    [ -z "$old" ] || echo 100 > /proc/sys/vm/compaction_proactiveness 2>/dev/null
+fi
