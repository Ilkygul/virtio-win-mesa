 private:
+    int retainFrameBeforeFirstAttachLocked(VulkanDisplayBridge& bridge, int64_t importId) {
+        static const bool enabled = envFlagEnabled("CROSVM_ANDROID_DISPLAY_RETAIN_FIRST_FRAME", false);
+        if (!enabled || mName != "scanout" || mHasAttached || !mRequestedSurfaceDimensions)
+            return -1;
+
+        if (!mRetainedFrame) {
+            const auto& size = *mRequestedSurfaceDimensions;
+            AHardwareBuffer_Desc desc = {
+                    .width = size.width,
+                    .height = size.height,
+                    .layers = 1,
+                    .format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM,
+                    .usage = AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT |
+                             AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+                             AHARDWAREBUFFER_USAGE_COMPOSER_OVERLAY,
+            };
+            AHardwareBuffer* buffer = nullptr;
+            if (AHardwareBuffer_allocate(&desc, &buffer) != 0 || !buffer) return -1;
+            mRetainedFrame.reset(buffer);
+        }
+
+        // The previous write must retire before this private target can be reused.
+        int targetAcquireFd = -1;
+        if (mRetainedFrameFence.get() >= 0) {
+            if (bridge.canImportAcquireFence()) targetAcquireFd = dup(mRetainedFrameFence.get());
+            if (targetAcquireFd < 0) {
+                const int waitFd = dup(mRetainedFrameFence.get());
+                if (waitFd < 0 || !waitForFence(waitFd).ok()) return -1;
+            }
+        }
+        auto completion = bridge.blit(importId, mRetainedFrame.get(), targetAcquireFd);
+        if (!completion.ok()) {
+            LOG(WARNING) << "Failed to retain startup scanout: " << completion.error();
+            mRetainedFrame.reset();
+            mRetainedFrameFence = ndk::ScopedFileDescriptor();
+            return -1;
+        }
+
+        // The virtio driver still receives the original source-read dependency.
+        int replayFence = *completion >= 0 ? dup(*completion) : -1;
+        if (*completion >= 0 && replayFence < 0) {
+            mRetainedFrame.reset();
+        } else {
+            mHasRetainedFrame = true;
+        }
+        mRetainedFrameFence = ndk::ScopedFileDescriptor(replayFence);
+        return *completion;
+    }
+
+    void showRetainedFrameLocked(ANativeWindow* window) {
+        if (!mHasRetainedFrame || !mRetainedFrame) return;
+        auto& sc = SurfaceControl::GetInstance();
+        ASurfaceControl* layer = sc.ASurfaceControl_createFromWindow(window, "retained-scanout");
+        if (!layer) return;
+        auto* transaction = sc.ASurfaceTransaction_create();
+        if (!transaction) {
+            sc.ASurfaceControl_release(layer);
+            return;
+        }
+
+        int fence = mRetainedFrameFence.get() < 0 ? -1 : dup(mRetainedFrameFence.get());
+        if (mRetainedFrameFence.get() >= 0 && fence < 0) {
+            sc.ASurfaceTransaction_delete(transaction);
+            sc.ASurfaceControl_release(layer);
+            return;
+        }
+        sc.ASurfaceTransaction_setBuffer(transaction, layer, mRetainedFrame.get(), fence);
+        sc.ASurfaceTransaction_apply(transaction);
+        sc.ASurfaceTransaction_delete(transaction);
+        mRetainedFrameLayer = layer;
+        LOG(INFO) << "Replayed retained startup scanout on first viewer attach";
+    }
+
+    void clearRetainedFrameLocked() {
+        if (mRetainedFrameLayer) {
+            auto& sc = SurfaceControl::GetInstance();
+            auto* transaction = sc.ASurfaceTransaction_create();
+            if (!transaction) return;
+            sc.ASurfaceTransaction_setBuffer(transaction, mRetainedFrameLayer, nullptr, -1);
+            sc.ASurfaceTransaction_apply(transaction);
+            sc.ASurfaceTransaction_delete(transaction);
+            sc.ASurfaceControl_release(mRetainedFrameLayer);
+            mRetainedFrameLayer = nullptr;
+        }
+        mRetainedFrame.reset();
+        mRetainedFrameFence = ndk::ScopedFileDescriptor();
+        mHasRetainedFrame = false;
+    }
