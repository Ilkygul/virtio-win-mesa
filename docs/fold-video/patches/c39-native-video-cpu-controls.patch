+/* Optional optimization only: absent/malformed capability retains strict
+ * Signal+Flush. TERMINAL v1 alone never implies this CPU-only contract. */
+static uint32_t job_native_cpu_controls(struct job_native *n)
+{
+   mtx_lock(&n->mutex);
+   if (!n->cpu_control_queried) {
+      struct npt_d3d11_video_terminal_v1 cap = {0};
+      PFN_ID3D11Device_CheckFeatureSupport query = NPT_COM_VTBL_FUNC(
+         PFN_ID3D11Device_CheckFeatureSupport, npt_com_vtable(n->device5), NPT_VTBL_ID3D11Device_CheckFeatureSupport);
+      const HRESULT hr = query(n->device5, (D3D11_FEATURE)NPT_D3D11_FEATURE_VIDEO_CPU_CONTROL_V1,
+                               &cap, sizeof(cap));
+      bool valid = hr == 0 && cap.magic == NPT_D3D11_VIDEO_CPU_CONTROL_MAGIC &&
+         cap.version == 1 && cap.size == sizeof(cap) &&
+         cap.supported == NPT_D3D11_VIDEO_CPU_CONTROL_SUPPORTED;
+      for (unsigned i = 0; i < 4; ++i) valid = valid && cap.reserved[i] == 0;
+      n->cpu_control_caps = valid ? cap.supported : 0;
+      n->cpu_control_queried = true;
+   }
+   const uint32_t caps = n->cpu_control_caps;
+   mtx_unlock(&n->mutex);
+   return caps;
+}
+
+/* Peek only the immutable wire prefix. The existing dispatcher remains
+ * responsible for full argument validation and unchanged HRESULT replies. */
+static uint32_t job_cpu_control_command(const struct npt_command_header *h,
+                                        const struct npt_cs_decoder *dec)
+{
+   if ((h->cmd_type >> 24) != 255 || ((h->cmd_type >> 8) & 0xffffu) != NPT_IFACE_ID_ID3D11VideoContext ||
+       (h->cmd_flags & ~NPT_CMD_FLAG_REPLY) || h->reserved || !h->object_id)
+      return 0;
+   const uint32_t method = h->cmd_type & 0xffu;
+   const size_t prefix = sizeof(*h) + 2 * sizeof(uint64_t) + sizeof(uint32_t);
+   if (method != NPT_METHOD_ID3D11VideoContext_DecoderBeginFrame &&
+       method != NPT_METHOD_ID3D11VideoContext_DecoderExtension) return 0;
+   if (h->cmd_size < prefix || h->cmd_size > (size_t)(dec->end - dec->cur)) return 0;
+   uint8_t bytes[sizeof(struct npt_command_header) + 2 * sizeof(uint64_t) + sizeof(uint32_t)];
+   npt_cs_decoder_peek(dec, sizeof(bytes), bytes, sizeof(bytes));
+   uint64_t decoder, second;
+   memcpy(&decoder, bytes + sizeof(*h), sizeof(decoder));
+   memcpy(&second, bytes + sizeof(*h) + sizeof(decoder), sizeof(second));
+   if (!decoder || !second) return 0;
+   if (method == NPT_METHOD_ID3D11VideoContext_DecoderBeginFrame)
+      return NPT_D3D11_VIDEO_CPU_BEGIN_FRAME;
+   uint32_t function;
+   memcpy(&function, bytes + sizeof(*h) + 2 * sizeof(uint64_t), sizeof(function));
+   return second == 1 && function == NPT_D3D11_VIDEO_CPU_INLINE_FUNCTION
+      ? NPT_D3D11_VIDEO_CPU_INLINE_SUBMIT : 0;
+}
+
+static void job_touch_native(struct npt_gpu_jobs *s, struct npt_job_ring *r,
+                              struct job_native *n, bool needs_signal)
+{
+   for (unsigned i = 0; i < r->touched_count; ++i) {
+      if (r->touched[i] == n) {
+         r->touched_needs_signal[i] |= needs_signal; /* Mixed GPU work wins. */
+         return;
+      }
+   }
+   if (r->touched_count >= JOB_MAX_NATIVE) { job_fail(s, "touched context bound exceeded"); return; }
+   const unsigned i = r->touched_count++;
+   r->touched[i] = n;
+   r->touched_needs_signal[i] = needs_signal;
+}
