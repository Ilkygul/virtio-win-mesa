+        KgslTimelineSignal signal = { reinterpret_cast<uintptr_t>(&point), 1, sizeof(point) };
+        valid = ioctl(publication->device, KgslSignalTimeline, &signal) == 0;
+      }
+    }
+    if (!valid) {
+      for (int slot : publication->slots)
+        pwrite(slot, "X", 1, 0);
+    }
