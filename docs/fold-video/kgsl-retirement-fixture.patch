+  struct DxvkCommandList::FuturePublication {
+    int device = -1;
+    int fence = -1;
+    uint32_t timeline = 0;
+    std::vector<int> slots;
+
+    ~FuturePublication() {
+      if (timeline)
+        ioctl(device, KgslDestroyTimeline, &timeline);
+      if (fence >= 0)
+        close(fence);
+      if (device >= 0)
+        close(device);
+      for (int fd : slots)
+        close(fd);
+    }
+
+    bool create() {
+      device = open("/dev/kgsl-3d0", O_RDWR | O_CLOEXEC);
+      KgslTimelineCreate create = {};
+      if (device < 0 || ioctl(device, KgslCreateTimeline, &create) < 0)
+        return false;
+      timeline = create.id;
+      KgslTimelineFence get = { 1, timeline, -1 };
+      if (ioctl(device, KgslGetTimelineFence, &get) < 0)
+        return false;
+      fence = get.fd;
+      return fence >= 0;
+    }
+  };
