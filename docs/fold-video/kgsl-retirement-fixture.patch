+  void DxvkCommandList::completeFuturePublication(bool completed) {
+    auto publication = std::move(m_futurePublication);
+    if (!publication)
+      return;
+
+    bool valid = completed;
+    for (int slot : publication->slots) {
+      if (flock(slot, LOCK_EX) < 0) {
+        Logger::err("NPT-FUTURE-PUBLICATION: retirement lock failed");
+        return; // Destroying the pending KGSL timeline wakes readers with a failure.
+      }
+      char state = 0;
+      if (pread(slot, &state, 1, 0) != 1 || state != 'P')
+        valid = false;
