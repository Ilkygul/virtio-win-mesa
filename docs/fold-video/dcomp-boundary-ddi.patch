+BOOL tritonBoundaryTraceEnabled(void)
+{
+    static volatile LONG state;
+    LONG value = InterlockedCompareExchange(&state, 0, 0);
+    if (!value) {
+        char path[MAX_PATH];
+        DWORD length = GetModuleFileNameA(NULL, path, sizeof(path));
+        const char *name = length && length < sizeof(path) ? strrchr(path, '\\') : NULL;
+        const BOOL enabled = name && !_stricmp(name + 1, "msedge.exe") &&
+            tritonSwitch("triton-boundary-trace");
+        value = enabled ? 2 : 1;
+        InterlockedCompareExchange(&state, value, 0);
+    }
+    return value == 2;
+}
+
+void tritonBoundaryTrace(PTRITON_DEVICE pD, const char *op, const void *dst, const void *src)
+{
+    if (!tritonBoundaryTraceEnabled()) return;
+    static volatile LONG count;
+    if (InterlockedIncrement(&count) > 4096) return;
+
+    const TRITON_RESOURCE *d = !strncmp(op, "StrictDraw", 10) ? NULL : dst;
+    const TRITON_RESOURCE *s = src;
+    LARGE_INTEGER qpc;
+    QueryPerformanceCounter(&qpc);
+    TR_LOG("DCompBoundary op=%s pid=%lu tid=%lu qpc=%lld dev=%p dst=%p dstAlloc=0x%x "
+           "dstImport=0x%x dstBind=0x%x dstMisc=0x%x dstSize=%ux%u src=%p srcAlloc=0x%x srcImport=0x%x",
+           op, (unsigned long)GetCurrentProcessId(), (unsigned long)GetCurrentThreadId(),
+           (long long)qpc.QuadPart, (void *)pD, dst, d ? (unsigned)d->hKMAllocation : 0,
+           d ? (unsigned)d->hImportAlloc : 0, d ? (unsigned)d->BindFlags : 0,
+           d ? (unsigned)d->MiscFlags : 0, d ? d->Width : 0, d ? d->Height : 0,
+           src, s ? (unsigned)s->hKMAllocation : 0, s ? (unsigned)s->hImportAlloc : 0);
 }
 
