+#ifdef __ANDROID__
+  static void nptTraceColorWrites(const D3D11ContextStateOM& om, const char* kind) {
+    static const bool enabled = env::getEnvVar("NPT_SHARED_COLOR_WRITES_TRACE") == "1";
+    if (!enabled)
+      return;
+
+    struct Counts { unsigned draws = 0; unsigned masked = 0; };
+    static thread_local Counts batches[2];
+    auto& counts = batches[kind[0] == 'i'];
+    const auto* blend = om.cbState.ptr();
+    if (blend && om.minUav >= om.maxUav && !om.dsv) {
+      const auto& desc = blend->Desc();
+      bool canWriteShared = false;
+      for (UINT i = 0; i < om.rtvs.size(); i++) {
+        if (om.rtvs[i]) {
+          const auto& view = om.rtvs[i]->GetImageView();
+          if (view && view->image()->info().sharing.mode != DxvkSharedHandleMode::None)
+            canWriteShared |= desc.RenderTarget[desc.IndependentBlendEnable ? i : 0].RenderTargetWriteMask != 0;
+        }
+      }
+      counts.masked += !canWriteShared;
+    }
+    if (++counts.draws == 256) {
+      Logger::warn(str::format("NPT-SHARED-COLOR-WRITES pid=", getpid(),
+        " kind=", kind, " draws=", counts.draws, " masked_without_dsv_or_uav=", counts.masked));
+      counts = {};
+    }
+  }
+#endif
