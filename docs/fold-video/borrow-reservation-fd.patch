diff --git a/src/dxvk/dxvk_image.cpp b/src/dxvk/dxvk_image.cpp
index 2f72cb54..122e1234 100644
--- a/src/dxvk/dxvk_image.cpp
+++ b/src/dxvk/dxvk_image.cpp
@@ -271,6 +271,15 @@ namespace dxvk {
       close(m_dmabufPublicationFd);
 
     m_dmabufPublicationFd = fd;
+    // Shared storage cannot relocate. Keep the exporter FD for reservation
+    // ioctls, which borrow it and never pass ownership to Vulkan.
+    char phase = 0;
+    if (fd >= 0 && m_info.sharing.mode == DxvkSharedHandleMode::Export
+     && m_dmabufReservationFd < 0 && pread(fd, &phase, 1, 0) == 1 && phase == 'L') {
+      int reservationFd = -1;
+      if (dupDmabufFd(&reservationFd) == VK_SUCCESS)
+        m_dmabufReservationFd = reservationFd;
+    }
     struct stat identity;
     m_dmabufPublicationInode = fd >= 0 && fstat(fd, &identity) == 0 ? identity.st_ino : 0;
   }
@@ -278,6 +287,8 @@ namespace dxvk {
 
   DxvkImage::~DxvkImage() {
 #ifdef __ANDROID__
+    if (m_dmabufReservationFd >= 0)
+      close(m_dmabufReservationFd);
     if (m_dmabufPublicationFd >= 0)
       close(m_dmabufPublicationFd);
 #endif
