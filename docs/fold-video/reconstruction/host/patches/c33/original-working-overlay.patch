+  // Rejection-only diagnostic: never changes validation or creation results.
+  // One logcat warning per failed validation, capped at 32 per process.
+  static void nptLogBlendState1Reject(const void* device,
+      const D3D11_BLEND_DESC1& desc, HRESULT hr) noexcept {
+    static std::atomic<uint32_t> count { 0 };
+    uint32_t seq = count.load(std::memory_order_relaxed);
+    do {
+      if (seq >= 32)
+        return;
+    } while (!count.compare_exchange_weak(seq, seq + 1,
+                                          std::memory_order_relaxed));
+
+    try {
+#if defined(_WIN32)
+      const uint32_t pid = uint32_t(GetCurrentProcessId());
+#else
+      const uint32_t pid = uint32_t(getpid());
+#endif
+      std::string message = str::format("NPT-BLEND-REJECT seq=", seq + 1,
+        " pid=", pid, " method=ID3D11Device1::CreateBlendState1 device=", device,
+        " hr=0x", std::hex, uint32_t(hr), std::dec,
+        " originalDesc=1 alphaToCoverage=", uint32_t(desc.AlphaToCoverageEnable),
+        " independent=", uint32_t(desc.IndependentBlendEnable));
+      // Include inactive RT entries too, without interpreting them as active.
+      for (uint32_t i = 0; i < D3D11_SIMULTANEOUS_RENDER_TARGET_COUNT; i++) {
+        const auto& rt = desc.RenderTarget[i];
+        message += str::format(" rt", i, "={enable:", uint32_t(rt.BlendEnable),
+          ",logicEnable:", uint32_t(rt.LogicOpEnable),
+          ",src:", uint32_t(rt.SrcBlend), ",dst:", uint32_t(rt.DestBlend),
+          ",op:", uint32_t(rt.BlendOp),
+          ",srcA:", uint32_t(rt.SrcBlendAlpha), ",dstA:", uint32_t(rt.DestBlendAlpha),
+          ",opA:", uint32_t(rt.BlendOpAlpha), ",logic:", uint32_t(rt.LogicOp),
+          ",write:0x", std::hex, uint32_t(rt.RenderTargetWriteMask), std::dec, "}");
+      }
+#if defined(__ANDROID__)
+      // Bypass DXVK's configurable log level and shared/overwritten log file.
+      __android_log_write(ANDROID_LOG_WARN, "NptBlendReject", message.c_str());
+#endif
+      Logger::warn(message);
+    } catch (...) {
+      // A diagnostic allocation/logging failure must not replace E_INVALIDARG.
+    }
+  }
+
