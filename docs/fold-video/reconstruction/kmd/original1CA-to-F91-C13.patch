+struct C12_NOTIFY_V2 {
+    ULONG Type, Flags;
+    ULONGLONG Object;
+    ULONG Size, HeaderReserved;
+    ULONGLONG RingId, Generation, PublishSerial;
+    ULONG EndTail, Reserved;
