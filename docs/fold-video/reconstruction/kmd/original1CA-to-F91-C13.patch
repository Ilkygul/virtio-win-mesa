+    for (UINT i = 0; m_AllocationHolds && i < m_allocationsLength; ++i) {
+        if ((m_AllocationHolds[i] & 1) &&
+            !ExAcquireRundownProtection(&m_allocations[i]->m_NativeJobRundown)) { return; }
+        if (m_AllocationHolds[i] & 1) { m_AllocationHolds[i] |= 2; }
+    }
+    m_NativePrepareOk = TRUE;
