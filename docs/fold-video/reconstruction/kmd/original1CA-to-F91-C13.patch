+// Actual accepted jobs own their ledger node. No window capacity prevents
+// another context from admitting the command that resolves a GPU Wait.
+// All list mutations are in the existing interrupt synchronization domain.
+struct NATIVE_DMA_CONTEXT {
+    VioGpuAdapter *Adapter;
+    NATIVE_DMA_RECORD *Record;
+    UINT FenceId;
+    UINT Node;
+    UINT Engine;
+    NTSTATUS Status;
+    BOOLEAN Found;
+};
+static BOOLEAN NativeRegisterSync(PVOID opaque)
+{
+    NATIVE_DMA_CONTEXT *c = (NATIVE_DMA_CONTEXT *)opaque;
+    VioGpuAdapter *a = c->Adapter;
+    c->Status = STATUS_INVALID_DEVICE_STATE;
+    if (a->m_NativeGpuFault || c->Node != 0 || c->Engine != 0 || !c->Record ||
+        c->Record->State != 0 || !c->Record->Owner) { return TRUE; }
+    if ((LONG)(c->Record->FenceId - (UINT)a->m_LastCompletedFenceId) <= 0) {
+        c->Status = STATUS_INVALID_PARAMETER; return TRUE;
+    }
+    if (!IsListEmpty(&a->m_NativeDmaList)) {
+        NATIVE_DMA_RECORD *tail = CONTAINING_RECORD(a->m_NativeDmaList.Blink, NATIVE_DMA_RECORD, Link);
+        if ((LONG)(c->Record->FenceId - tail->FenceId) <= 0) {
+            c->Status = STATUS_INVALID_PARAMETER; return TRUE;
+        }
+    }
+    c->Record->State = 1;
+    InsertTailList(&a->m_NativeDmaList, &c->Record->Link);
+    ++a->m_NativeDmaCount;
+    c->Status = STATUS_SUCCESS;
+    return TRUE;
+}
+static BOOLEAN NativeStartSync(PVOID opaque)
+{
+    NATIVE_DMA_CONTEXT *c = (NATIVE_DMA_CONTEXT *)opaque;
+    VioGpuAdapter *a = c->Adapter;
+    for (LIST_ENTRY *e = a->m_NativeDmaList.Flink; e != &a->m_NativeDmaList; e = e->Flink) {
+        NATIVE_DMA_RECORD *r = CONTAINING_RECORD(e, NATIVE_DMA_RECORD, Link);
+        if (r->FenceId == c->FenceId && r->State == 1) {
+            r->State = 2; c->Found = TRUE; return TRUE;
+        }
+    }
+    return TRUE;
+}
+static BOOLEAN NativeOutstandingSync(PVOID opaque)
+{
+    NATIVE_DMA_CONTEXT *c = (NATIVE_DMA_CONTEXT *)opaque;
+    c->Found = !IsListEmpty(&c->Adapter->m_NativeDmaList);
+    return TRUE;
+}
+NTSTATUS VioGpuAdapter::NativeRegisterFence(NATIVE_DMA_RECORD *record, UINT node, UINT engine)
+{
+    NATIVE_DMA_CONTEXT c = {this, record, 0, node, engine, STATUS_UNSUCCESSFUL, FALSE};
+    BOOLEAN ran = FALSE;
+    NTSTATUS st = m_DxgkInterface.DxgkCbSynchronizeExecution(m_DxgkInterface.DeviceHandle,
+        NativeRegisterSync, &c, 0, &ran);
+    return NT_SUCCESS(st) && ran ? c.Status : STATUS_UNSUCCESSFUL;
+}
+BOOLEAN VioGpuAdapter::NativeStartFence(UINT id)
+{
+    NATIVE_DMA_CONTEXT c = {this, NULL, id, 0, 0, STATUS_UNSUCCESSFUL, FALSE};
+    BOOLEAN ran = FALSE;
+    NTSTATUS st = m_DxgkInterface.DxgkCbSynchronizeExecution(m_DxgkInterface.DeviceHandle,
+        NativeStartSync, &c, 0, &ran);
+    return (BOOLEAN)(NT_SUCCESS(st) && ran && c.Found);
+}
+BOOLEAN VioGpuAdapter::NativeHasOutstanding()
+{
+    NATIVE_DMA_CONTEXT c = {this, NULL, 0, 0, 0, STATUS_UNSUCCESSFUL, TRUE};
+    BOOLEAN ran = FALSE;
+    NTSTATUS st = m_DxgkInterface.DxgkCbSynchronizeExecution(m_DxgkInterface.DeviceHandle,
+        NativeOutstandingSync, &c, 0, &ran);
+    return (BOOLEAN)(!NT_SUCCESS(st) || !ran || c.Found);
+}
+void VioGpuAdapter::NativeFail()
+{
+    InterlockedExchange(&m_NativeGpuFault, 1);
+}
 
