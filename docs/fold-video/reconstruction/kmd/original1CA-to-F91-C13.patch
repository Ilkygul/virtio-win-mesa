+void VioGpuVidPN::StopNativeWorker()
+{
+    PAGED_CODE();
+    if (KeWaitForSingleObject(&m_NativeStopMutex, Executive, KernelMode, FALSE, NULL) != STATUS_SUCCESS) {
+        m_pAdapter->NativeFail();
+        KEVENT hold; KeInitializeEvent(&hold, NotificationEvent, FALSE);
+        for (;;) { KeWaitForSingleObject(&hold, Executive, KernelMode, FALSE, NULL); }
+    }
+    m_shouldFlipStop = TRUE;
+    KeSetEvent(&m_flipReadyEvent, IO_NO_INCREMENT, FALSE);
+    BOOLEAN unknown = m_NativeFlipUnknown;
+    if (m_pFlipThread) {
+        NTSTATUS joined = KeWaitForSingleObject(m_pFlipThread, Executive, KernelMode, FALSE, NULL);
+        if (joined == STATUS_SUCCESS) {
+            ObDereferenceObject(m_pFlipThread);
+            m_pFlipThread = NULL;
+        } else { unknown = TRUE; }
+    }
+    if (unknown) {
+        m_pAdapter->NativeFail();
+        KEVENT hold; KeInitializeEvent(&hold, NotificationEvent, FALSE);
+        for (;;) { KeWaitForSingleObject(&hold, Executive, KernelMode, FALSE, NULL); }
+    }
+    KeReleaseMutex(&m_NativeStopMutex, FALSE);
+}
