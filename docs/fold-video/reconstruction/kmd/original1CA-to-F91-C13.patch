+        q && r && q->type == VIRTIO_GPU_CMD_SUBMIT_3D && r->type == VIRTIO_GPU_RESP_OK_NODATA &&
+        r->flags == expected && r->ctx_id == q->ctx_id &&
+        q->ring_idx == 0 && r->ring_idx == 0 && r->fence_id == q->fence_id &&
+        ((q->flags & VIOGPU_NATIVE_JOB_REQUEST_V1) != 0) == (self->m_NativeRequiresGpuProof != FALSE));
+    self->m_NativeResponseType = r ? r->type : 0;
+    self->m_NativeResponseFlags = r ? r->flags : 0;
+    self->m_NativeResponseContext = r ? r->ctx_id : 0;
+    self->m_NativeResponseFence = r ? r->fence_id : 0;
