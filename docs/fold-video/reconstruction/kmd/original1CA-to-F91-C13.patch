+static LONG NativeNotifyClass(const void *body, ULONG bytes)
+{
+    if (bytes < sizeof(ULONG)) { return 0; }
+    ULONG type = 0;
+    RtlCopyMemory(&type, body, sizeof(type));
+    if (type != 0x00010009u) { return 0; }
+    if (bytes != sizeof(C12_NOTIFY_V2)) { return -1; }
+    C12_NOTIFY_V2 n;
+    RtlCopyMemory(&n, body, sizeof(n));
+    return n.Flags == 0 && n.Object == 0 && n.Size == sizeof(n) &&
+        n.HeaderReserved == 0 && n.RingId != 0 && n.Generation != 0 &&
+        n.PublishSerial != 0 && n.Reserved == 0 ? 1 : -1;
+}
