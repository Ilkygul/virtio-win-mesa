+void VioGpuCommand::ReleaseNativeLifetime()
+{
+    for (UINT i = 0; m_AllocationHolds && i < m_allocationsLength; ++i) {
+        if (m_AllocationHolds[i] & 2) {
+            ExReleaseRundownProtection(&m_allocations[i]->m_NativeJobRundown);
