diff --git a/src/d3d11/d3d11_context_imm.cpp b/src/d3d11/d3d11_context_imm.cpp
index f37c22e3..2afbe92d 100644
--- a/src/d3d11/d3d11_context_imm.cpp
+++ b/src/d3d11/d3d11_context_imm.cpp
@@ -927,6 +927,28 @@ namespace dxvk {
 
 
   VkResult D3D11ImmediateContext::NptWaitForAtlasPublication() {
+#ifdef __ANDROID__
+    static const bool trace = env::getEnvVar("NPT_DMABUF_PUBLICATION_TIMING") == "1";
+    static thread_local unsigned publications = 0;
+    if (trace && (++publications & 63u) == 0) {
+      using Clock = std::chrono::steady_clock;
+      const auto startedAt = Clock::now();
+      m_submitStatus.tracePublication = true;
+      ExecuteFlush(GpuFlushType::ExplicitFlush, nullptr, false, nullptr, true);
+      const auto returnedAt = Clock::now();
+      m_submitStatus.tracePublication = false;
+      const auto elapsed = [](auto first, auto last) {
+        return std::chrono::duration_cast<std::chrono::microseconds>(last - first).count();
+      };
+      Logger::warn(str::format("NPT-PUBLICATION-TIMING pid=", getpid(),
+        " dispatch_us=", elapsed(startedAt, m_submitStatus.queuedAt),
+        " queue_us=", elapsed(m_submitStatus.queuedAt, m_submitStatus.dequeuedAt),
+        " submit_us=", elapsed(m_submitStatus.dequeuedAt, m_submitStatus.completedAt),
+        " wake_us=", elapsed(m_submitStatus.completedAt, returnedAt),
+        " result=", int(m_submitStatus.result.load())));
+      return m_submitStatus.result;
+    }
+#endif
     ExecuteFlush(GpuFlushType::ExplicitFlush, nullptr, false, nullptr, true);
     return m_submitStatus.result;
   }
